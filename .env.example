# Meta webhook handshake — any string you choose; paste the same value into
# the Meta app's webhook configuration.
IG_VERIFY_TOKEN=choose-a-random-string

# Instagram user access token with instagram_business_manage_messages.
IG_USER_ACCESS_TOKEN=

# App secret from the Meta app dashboard, used to verify payload signatures.
IG_APP_SECRET=

# IG-scoped ID of the studio's Instagram account. Only webhook events for this
# account are replied to; events for any other account on the same app are
# ignored.
IG_ACCOUNT_ID=

# Optional, comma-separated IG-scoped sender ids. While set, only these
# senders get replies while testing; everyone else's DMs are stored but
# ignored. Leave empty once ready to go live for all customers.
ALLOWED_SENDER_IDS=

# Token for a named Cloudflare Tunnel (Zero Trust dashboard > Networks >
# Tunnels > your tunnel > Configure). Gives the tunnel service a stable
# hostname that survives restarts, instead of a fresh random URL every time.
CLOUDFLARE_TUNNEL_TOKEN=

# Anthropic API key used to generate replies.
ANTHROPIC_API_KEY=

# Optional — defaults shown.
IG_API_VERSION=v26.0
PORT=3000
# Set to DEBUG to log the full raw body of every webhook POST (sender/message
# ids, text, etc). Off by default since customer message text ends up in logs.
LOG_LEVEL=INFO
CANNED_REPLY=Γεια σου! Ελάβαμε το μήνυμά σου και θα σου απαντήσουμε σύντομα.

# Reply model. Opus 5 is a pricier alternative; Haiku 4.5 is cheaper.
ANTHROPIC_MODEL=claude-sonnet-5
# Output ceiling, covering thinking plus reply text.
LLM_MAX_TOKENS=2000
LLM_EFFORT=low

# Conversation storage. DB_PATH is set to /srv/data/history.db in the image.
HISTORY_RETENTION_DAYS=20
HISTORY_WINDOW_MESSAGES=20
